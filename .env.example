# Local media runtime settings. Application/model/session settings are separate.
# Existing persistent application root; renderer writes only its media child.
VIDEO_DATA_DIR=/var/lib/videobuddy
# Production: separate renderer via Unix-domain socket. Omit for local development.
VIDEO_RENDER_SOCKET=/var/lib/videobuddy/media/render.sock
VIDEO_FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_FFPROBE_PATH=/usr/bin/ffprobe
# Chromium is installed at deploy time from package-lock.json's Playwright version.
PLAYWRIGHT_BROWSERS_PATH=/opt/videobuddy/browsers
# Read-only licensed music library, copied into render jobs by the application as required.
VIDEO_MUSIC_DIR=/var/lib/videobuddy/music
# Never set this in production; explicit development-only escape hatch, not a passing sandbox check.
VIDEO_UNSAFE_NO_SANDBOX=0
