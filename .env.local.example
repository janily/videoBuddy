# 应用自定义配置示例，不是已经可部署的密钥文件。
# 在真实工程复制/合并到 .env.local.example；不得提交真实 key。
# enable 前先完成 T00 的平台/SDK探针与预算配置。
VIDEO_GENERATION_ENABLED=false
VIDEO_ENVIRONMENT=preview-main
VIDEO_APP_ORIGIN=http://localhost:3000
VIDEO_SESSION_KEY_ID=v1
VIDEO_SESSION_SIGNING_KEY=
VIDEO_SESSION_PREVIOUS_KEY=
VIDEO_SESSION_TTL_DAYS=30
VIDEO_PROJECT_RETENTION_DAYS=30
VIDEO_PREVIEW_TTL_HOURS=24
VIDEO_GLOBAL_HEAVY_CONCURRENCY=2
VIDEO_OWNER_HEAVY_CONCURRENCY=1
VIDEO_CREATIVE_REPAIR_LIMIT=2
VIDEO_NETWORK_RETRY_LIMIT=2
VIDEO_SSE_ROTATE_SECONDS=240
VIDEO_SSE_HEARTBEAT_SECONDS=15
VIDEO_CRON_SECRET=
# 资源预算需由项目负责人填写正整数，缺失时禁止真实生成，不默认无限。
VIDEO_PROJECT_MAX_MODEL_CALLS=
VIDEO_PROJECT_MAX_INPUT_TOKENS=
VIDEO_PROJECT_MAX_OUTPUT_TOKENS=
VIDEO_PROJECT_MAX_TTS_CHARACTERS=
VIDEO_PROJECT_MAX_SANDBOX_SECONDS=
VIDEO_DAILY_MAX_MODEL_CALLS=
VIDEO_DAILY_MAX_SANDBOX_SECONDS=
# 独立实现并适配外部参考的 provider 组织；ID必须使用实际供应商支持的模型。
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
VIDEO_DIRECTOR_MODEL=
VIDEO_VISUAL_MODEL=
VIDEO_AUDIO_MODEL=
VIDEO_CRITIC_MODEL=
SOURCE_ANALYSIS_MODEL=
SOURCE_ANALYSIS_BASE_URL=
SOURCE_ANALYSIS_API_KEY=
# Blob在Vercel优先平台集成/OIDC；本地或明确需要时使用服务端RW token。
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Sandbox由SDK/平台身份解析；本地按已锁定SDK的认证要求配置，勿传给生成代码。
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
VIDEO_SANDBOX_IMAGE_REF=
VIDEO_SANDBOX_RUNTIME_DIGEST=
VIDEO_SANDBOX_TIMEOUT_SECONDS=
# TTS是尚未接入的候选路线，填写这些项不会自动启用；需要真实可用性与许可核对。
VIDEO_TTS_ZH_PROVIDER=edge-tts
VIDEO_TTS_EN_PROVIDER=kokoro
VIDEO_TTS_ZH_VOICE=zh-CN-XiaoxiaoNeural
# 显式授权才运行付费真实测试；默认测试不能调用付费服务。
RUN_VIDEO_CLOUD_TESTS=0
RUN_VIDEO_MODEL_TESTS=0
RUN_VIDEO_STYLE_TESTS=0
