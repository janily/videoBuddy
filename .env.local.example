# Self-hosted VideoBuddy. Never commit real values. The data directory must be an absolute path on a persistent local disk.
VIDEO_GENERATION_ENABLED=false
# New previews: full (legacy complete certification) or mvp (any of the 43 styles, 16:9, 20-30s).
VIDEO_DELIVERY_PROFILE=mvp
# Sound: off = visual-only films (no narration, music or captions; no voice/ASR/audio model).
# Unset means off in mvp and on in full.
VIDEO_SOUND=off
VIDEO_ENVIRONMENT=local
VIDEO_APP_ORIGIN=http://localhost:3000
VIDEO_DATA_DIR=
VIDEO_SESSION_KEY_ID=v1
VIDEO_SESSION_SIGNING_KEY=
VIDEO_SESSION_PREVIOUS_KEY=
VIDEO_PROJECT_RETENTION_DAYS=30
VIDEO_PREVIEW_TTL_HOURS=24
VIDEO_GLOBAL_HEAVY_CONCURRENCY=2
VIDEO_OWNER_HEAVY_CONCURRENCY=1
VIDEO_CREATIVE_REPAIR_LIMIT=2
VIDEO_NETWORK_RETRY_LIMIT=2
VIDEO_SSE_ROTATE_SECONDS=240
VIDEO_SSE_HEARTBEAT_SECONDS=15
# No implicit unlimited spending.
VIDEO_PROJECT_MAX_MODEL_CALLS=
VIDEO_PROJECT_MAX_INPUT_TOKENS=
VIDEO_PROJECT_MAX_OUTPUT_TOKENS=
VIDEO_PROJECT_MAX_TTS_CHARACTERS=
VIDEO_PROJECT_MAX_MEDIA_SECONDS=
VIDEO_DAILY_MAX_MODEL_CALLS=
VIDEO_DAILY_MAX_MEDIA_SECONDS=
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
VIDEO_DIRECTOR_MODEL=
VIDEO_VISUAL_MODEL=
VIDEO_AUDIO_MODEL=
VIDEO_CRITIC_MODEL=
SOURCE_ANALYSIS_MODEL=
SOURCE_ANALYSIS_BASE_URL=
SOURCE_ANALYSIS_API_KEY=
# Build the trusted local image and set its immutable digest before running PDF source analysis or media work.
VIDEO_MEDIA_IMAGE_REF=
VIDEO_MEDIA_RUNTIME_DIGEST=
VIDEO_MEDIA_TIMEOUT_SECONDS=600
# Fetch pinned offline voice assets, build the local voice image, and set its immutable image ID.
VIDEO_VOICE_IMAGE_REF=
VIDEO_VOICE_RUNTIME_DIGEST=
VIDEO_ASR_IMAGE_REF=
VIDEO_ASR_RUNTIME_DIGEST=
VIDEO_ASR_MODEL=Systran/faster-whisper-small
RUN_VIDEO_MODEL_TESTS=0
RUN_VIDEO_STYLE_TESTS=0
