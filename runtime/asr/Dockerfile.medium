FROM python:3.11-slim-bookworm@sha256:2333bd330d12de02514770b3585cad313644316047cdee24a7acfdece6de6efb AS verified-model
COPY --from=medium_model . /model
COPY diagnostics/fetch-medium.py /verify_model.py
RUN python - <<'PY'
import runpy
from pathlib import Path
pins = runpy.run_path('/verify_model.py')
for name, (expected, size) in pins['FILES'].items():
    path = Path('/model') / name
    assert path.is_file() and not path.is_symlink() and path.stat().st_size == size
    assert pins['digest'](path) == expected, name
print('verified all four pinned medium model files')
PY

FROM python:3.11-slim-bookworm@sha256:2333bd330d12de02514770b3585cad313644316047cdee24a7acfdece6de6efb
ENV HOME=/tmp \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VIDEO_ASR_MODEL=Systran/faster-whisper-medium
WORKDIR /opt/videobuddy/asr
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY transcribe.py ./
COPY --chmod=0444 --from=verified-model /model/config.json /model/model.bin /model/tokenizer.json /model/vocabulary.txt ./model/
RUN --network=none chmod 0555 ./model
USER 10001:10001
RUN --network=none python - <<'PY'
import os
from pathlib import Path
import faster_whisper
assert all(os.access(Path('model') / name, os.R_OK) for name in ('config.json', 'model.bin', 'tokenizer.json', 'vocabulary.txt'))
print('non-root model files readable; inference dependencies import successfully')
PY
CMD ["python3", "/opt/videobuddy/asr/transcribe.py", "/work/job.json"]
