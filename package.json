{
  "name": "videobuddy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:video": "vitest run",
    "test:video:e2e": "playwright test",
    "doctor": "node --import tsx scripts/video/doctor.ts",
    "test:video:styles": "node --import tsx scripts/video/styles.ts",
    "worker": "node --import tsx scripts/video/worker.ts",
    "worker:sources": "node --import tsx scripts/video/source-worker.ts",
    "test:video:platform": "vitest run tests/video/self-hosted-storage.test.ts tests/video/local-stream.test.ts tests/video/local-worker.test.ts tests/video/worker-lease.test.ts tests/video/local-director.test.ts tests/video/artifact-token.test.ts tests/video/local-artifact.test.ts tests/video/render-transport.test.ts",
    "dev:mvp": "node scripts/video/dev-mvp.mjs",
    "worker:mvp": "node --env-file=.env.mvp.local --import tsx scripts/video/worker.ts",
    "worker:render": "node --import tsx scripts/video/render-worker.ts",
    "render:mvp": "node --env-file=.env.mvp.local --import tsx scripts/video/render-worker.ts",
    "migrate:quick": "node --import tsx scripts/video/migrate-quick-only.ts",
    "bench:runtime": "node --import tsx scripts/video/bench-runtime.ts",
    "postinstall": "node scripts/runtime/prepare-fonts.mjs",
    "samples:build": "node --import tsx scripts/video/build-style-samples.ts",
    "samples:verify": "node --import tsx scripts/video/build-style-samples.ts --verify-only",
    "fonts:prepare": "node scripts/runtime/prepare-fonts.mjs"
  },
  "dependencies": {
    "@mastra/core": "1.74.0",
    "@opentelemetry/api": "1.9.1",
    "@tailwindcss/postcss": "4.3.3",
    "acorn": "8.15.0",
    "next": "16.3.8",
    "opencc-js": "1.4.1",
    "pdfjs-dist": "6.3.289",
    "pinyin-pro": "3.29.4",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "nanoid": "5.1.16",
    "devalue": "5.9.3"
  }
}
