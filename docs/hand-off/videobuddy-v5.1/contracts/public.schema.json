          "enum": [
            "tts",
            "user_recording",
            "none"
          ]
        },
        "voiceAssetId": {
          "type": "string",
          "format": "uuid"
        },
        "musicMode": {
          "enum": [
            "composed",
            "user_track",
            "none"
          ]
        },
        "musicAssetId": {
          "type": "string",
          "format": "uuid"
        },
        "captions": {
          "enum": [
            "auto",
            "none"
          ]
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
