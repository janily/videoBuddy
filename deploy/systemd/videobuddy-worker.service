[Unit]
Description=VideoBuddy durable worker
After=network-online.target videobuddy-render.service
Wants=network-online.target

[Service]
Type=simple
User=videobuddy
Group=videobuddy
SupplementaryGroups=videobuddy-media
WorkingDirectory=/opt/videobuddy/current
EnvironmentFile=/etc/videobuddy/video.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --import tsx scripts/video/worker.ts
Restart=on-failure
RestartSec=5
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/videobuddy

[Install]
WantedBy=multi-user.target
