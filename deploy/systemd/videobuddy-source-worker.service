[Unit]
Description=VideoBuddy PDF source analysis worker
After=videobuddy-render.service

[Service]
Type=simple
User=videobuddy
Group=videobuddy
SupplementaryGroups=videobuddy-media
WorkingDirectory=/opt/videobuddy/current
EnvironmentFile=/etc/videobuddy/video.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --import tsx scripts/video/source-worker.ts
Restart=on-failure
RestartSec=5
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/videobuddy

[Install]
WantedBy=multi-user.target
